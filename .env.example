# RootCause — Environment Variables
# Copy this file to .env and fill in values

# LLM Provider (optional — mock provider used if not set)
# The system uses litellm, so it supports virtually any provider.
# You can set a generic LLM_API_KEY and LLM_MODEL, or use provider-specific keys.

# Generic universal approach:
# LLM_API_KEY=your-api-key
# LLM_MODEL=gpt-4o-mini  # (e.g., claude-3-5-sonnet-20240620, gemini/gemini-1.5-pro, etc.)

# --- Provider Specific Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Optional: If you use a provider-specific key but want to specify the model
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
# GEMINI_MODEL=gemini/gemini-1.5-flash

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite:///data/root_cause.db
